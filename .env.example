# Sightr bridge configuration. Copy this file to the Herdr plugin config directory:
# Copy-Item .env.example "$(herdr plugin config-dir herdr.sightr)\.env"
# Values use plain KEY=value syntax with no shell expansion or command substitution.
# This file may hold SIGHTR_VAPID_PRIVATE; start tightens its file permissions.

# --- Networking ---
# Bridge listening port.
SIGHTR_PORT=8787
# Loopback bind host.
SIGHTR_HOST=127.0.0.1
# Explicitly permit a non-loopback bind; leave unset for the safe default.
# SIGHTR_ALLOW_NON_LOOPBACK_BIND=1
# Skip the control script's publication step when a reverse proxy is in front.
# SIGHTR_SKIP_SERVE=1

# --- Herdr connection ---
# Herdr control socket path; normally injected by Herdr.
# HERDR_SOCKET_PATH=C:\Users\you\AppData\Roaming\herdr\herdr.sock
# Set by Herdr; do not set by hand.
# HERDR_PLUGIN_CONFIG_DIR=C:\Users\you\AppData\Roaming\herdr\plugins\config\herdr.sightr
# Set by Herdr; do not set by hand.
# HERDR_PLUGIN_STATE_DIR=C:\Users\you\AppData\Local\herdr\plugins\herdr.sightr

# --- Polling and pane view ---
# Active poll interval in milliseconds.
SIGHTR_POLL_MS=1500
# Idle poll interval in milliseconds.
# SIGHTR_POLL_IDLE_MS=12000
# Initial notification delay in milliseconds; Settings can change it live.
# SIGHTR_NOTIFY_DELAY_MS=30000
# Initial number of pane output lines; Settings can change it live.
SIGHTR_READ_LINES=200
# Initial reply submit keys, separated by commas; Settings can change them live.
SIGHTR_SUBMIT_KEYS=Enter

# --- Pane history ---
# Read conversation history from each agent's own session log.
# SIGHTR_TRANSCRIPT=on
# Claude session-log root; pi, Grok, and Cursor honour their normal home variables and descriptor settings.
# SIGHTR_CLAUDE_ROOT=C:\Users\you\.claude\projects
# SIGHTR_PI_ROOT=C:\Users\you\.pi\agent\sessions
# SIGHTR_GROK_ROOT=C:\Users\you\.grok\sessions
# SIGHTR_CURSOR_ROOT=C:\Users\you\.cursor\projects

# --- Beacons ---
# Read the identity files Claude's own hooks write, instead of reading a pane's identity off its
# screen. Install the hooks with:  sightr-ctl.ps1 hooks install claude
# SIGHTR_BEACONS=on

# --- Security ---
# Tailscale login allowed to use the bridge.
# SIGHTR_TRUSTED_USER=you@example.com
# Permit requests without a Tailscale identity header; development only.
# SIGHTR_TRUSTED_USER_OPTIONAL=1
# Reverse-proxy header containing an opaque device identifier.
# SIGHTR_DEVICE_HEADER=X-Device-Id
# Device identifiers permitted to perform sensitive actions.
# SIGHTR_DEVICE_ALLOWLIST=my-phone,my-laptop
# Append every write to <state-dir>/audit.log; set to 0 to record nothing.
# SIGHTR_AUDIT=1
# How much of each value the trail keeps: preview (120 characters) or none (redacted).
# SIGHTR_AUDIT_CONTENT=preview
# Additional browser origins, including scheme.
# SIGHTR_ALLOWED_ORIGINS=https://sightr.example.com
# Hostnames permitted by the host allowlist.
# SIGHTR_PUBLIC_HOSTS=herd.your-tailnet.ts.net
# Hosts discovered by the control script; normally injected automatically.
# SIGHTR_TAILSCALE_HOSTS=herd.your-tailnet.ts.net
# Disable host validation; debugging only.
# SIGHTR_ALLOW_ANY_HOST=1

# --- Paths ---
# Runtime state directory for subscriptions and other bridge state.
# SIGHTR_STATE_DIR=C:\Users\you\AppData\Local\sightr
# Root exposed by the read-only Files tab.
# SIGHTR_WORK_ROOT=C:\Users\you\Projects

# --- Web Push ---
# VAPID public key; generate with the control script.
# SIGHTR_VAPID_PUBLIC=
# VAPID private key; keep this secret.
# SIGHTR_VAPID_PRIVATE=
# VAPID contact subject, such as a mailto address.
# SIGHTR_VAPID_SUBJECT=mailto:you@example.com
# Extra push-service hostnames, if using a self-hosted service.
# SIGHTR_PUSH_ALLOWED_HOSTS=push.example.com
