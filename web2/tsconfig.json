{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // As T3 Code's apps/web, so adopted files compile unchanged.
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    // No noUncheckedIndexedAccess: v1 lib files imported through `@v1` are checked under this config
    // and were not written for it (web/tsconfig.json leaves it off too).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // `@/*` tries web2 first, then v1: a v1 lib file imported through `@v1` that says `@/lib/x` finds
    // its own sibling (v1-scope.ts does the same for Vite). The `~/lib/...` shim entries mirror
    // t3-shims.ts; `~/*` is T3's own root alias, kept so adopted files need no import edits.
    "paths": {
      "@/*": ["./src/*", "../web/src/*"],
      "@shared/*": ["../shared/*"],
      "@v1/*": ["../web/src/*"],
      "~/lib/windowControlsOverlay": ["./src/t3/shims/windowControlsOverlay.ts"],
      "@t3tools/client-runtime/work-log/presentation": ["./src/t3/client-runtime/work-log/presentation.ts"],
      "@t3tools/client-runtime/work-log/command-label": ["./src/t3/shims/commandLabel.ts"],
      "@t3tools/shared/orchestrationTiming": ["./src/t3/shared/orchestrationTiming.ts"],
      "@t3tools/shared/toolActivity": ["./src/t3/shared/toolActivity.ts"],
      "@t3tools/shared/toolOutput": ["./src/t3/shims/toolOutput.ts"],
      "@t3tools/client-runtime/state/composer-dispatch": ["./src/t3/client-runtime/state/composerDispatch.ts"],
      "@t3tools/shared/searchRanking": ["./src/t3/shared/searchRanking.ts"],
      "@t3tools/contracts": ["./src/t3/contracts/index.ts"],
      "@t3tools/shared/keybindings": ["./src/t3/shared/keybindings.ts"],
      "~/*": ["./src/*"]
    }
  },
  // src/sw.ts runs in a service-worker context; tsconfig.worker.json checks it.
  "include": ["src", "../shared", "*.ts"],
  "exclude": ["src/sw.ts"]
}
