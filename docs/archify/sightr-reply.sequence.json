        "id": "authorise",
        "label": "Authorise the write",
        "focus": [
          "pwa",
          "bridge",
          "access"
        ],
        "note": "Host allowlist, then same-origin, then the Tailscale login, then the device header. Any failure is a 403 before routing."
      },
      {
        "id": "write-pane",
        "label": "Write the pane",
        "focus": [
          "reply",
          "queue",
          "herdrc",
          "pane"
        ],
        "note": "One promise chain per pane. Text, a 350 ms settle, then the submit key — two one-shot RPCs that must not interleave."
      },
      {
        "id": "update-back",
        "label": "Update comes back",
        "focus": [
          "pane",
          "engine",
          "sse",
          "pwa"
        ],
        "note": "The Herdr event only pokes a re-poll. The fresh snapshot is what reaches the phone, coalesced onto the SSE stream."
      }
    ]
