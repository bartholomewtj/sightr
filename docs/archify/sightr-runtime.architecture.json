        "id": "reply-path",
        "label": "Reply path",
        "focus": [
          "webpwa",
          "tailscale",
          "bridge",
          "panequeue",
          "herdrclient",
          "herdr",
          "panes"
        ],
        "note": "A phone reply crosses the tailnet, clears the gate, waits its turn in the pane queue, and lands as two one-shot RPCs."
      },
      {
        "id": "snapshot-path",
        "label": "Snapshot + SSE",
        "focus": [
          "engine",
          "herdrclient",
          "herdr",
          "snapshot",
          "bridge",
          "webpwa"
        ],
        "note": "The poll is the source of truth. Herdr events only poke it; each fresh snapshot is pushed to the phone over SSE."
      },
      {
        "id": "security",
        "label": "Security boundary",
        "focus": [
          "webpwa",
          "tailscale",
          "access",
          "bridge",
          "audit"
        ],
        "note": "Tailscale proves the device, not the person. The bridge binds loopback and gates host, origin, identity and device."
      },
      {
        "id": "notifications",
        "label": "Background notifications",
        "focus": [
          "engine",
          "push",
          "webpwa"
        ],
        "note": "Optional. A status transition debounces into one herd-tagged Web Push message; the service worker renders it."
      }
